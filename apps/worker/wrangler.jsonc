{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailverify",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mailverify",
      "database_id": "adce9a67-ba22-48b8-a3aa-583c1a285a57",
      "migrations_dir": "../../migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0de8d66a36544e0e92d674ba61caaa15"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
