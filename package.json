{
  "name": "email-verifier-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:worker": "npm run dev --workspace=apps/worker",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=apps/worker",
    "sync:disposable": "node scripts/sync-disposable-domains.mjs",
    "typecheck": "tsc --noEmit --project apps/worker/tsconfig.json && tsc --noEmit --project apps/web/tsconfig.json"
  }
}
